          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="04 - POST Book Hotel (S14: form-encoded body from extracted values)" enabled="true">
            <stringProp name="HTTPSampler.path">/BookingConfirm.php</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">${bookingFormBody}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="S14 Content-Type: form-encoded (NOT json - Adactin uses PHP forms)" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Content-Type</stringProp>
                  <stringProp name="Header.value">application/x-www-form-urlencoded</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="S14 PreProcessor - Build booking form body (API chaining + body construction)" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">
// SESSION 14: Form body construction from extracted values
// All values came from RegEx Extractors in previous steps (API chaining)
// Elvis ?: provides safe defaults if extraction failed

def hotelName = vars.get(&quot;hotel_name_hid&quot;) ?: vars.get(&quot;hotelName&quot;) ?: &quot;Hotel Creek&quot;
def roomType  = vars.get(&quot;room_type_hid&quot;)  ?: &quot;Standard&quot;

// Clean and URL-encode string fields
// replaceAll() chain: remove HTML entities then encode for form submission
def encodedHotel = java.net.URLEncoder.encode(
    hotelName.trim().replaceAll(&quot;&amp;amp;&quot;, &quot;&amp;&quot;).replaceAll(&quot;[^\\w\\s\\-]&quot;, &quot;&quot;).trim(),
    &quot;UTF-8&quot;
)
def encodedRoom = java.net.URLEncoder.encode(roomType.trim(), &quot;UTF-8&quot;)

// Build form-encoded body: key=value&amp;key=value
// All hidden field values extracted from the booking form in Step 3
def body = &quot;hotel_name=&quot;         + encodedHotel
         + &quot;&amp;room_type=&quot;        + encodedRoom
         + &quot;&amp;arrival_date=10%2F12%2F2025&quot;
         + &quot;&amp;departure_date=12%2F12%2F2025&quot;
         + &quot;&amp;number_of_rooms=1&quot;
         + &quot;&amp;adults=1&quot;
         + &quot;&amp;child=0&quot;
         + &quot;&amp;temp_price=&quot;       + (vars.get(&quot;temp_price&quot;) ?: &quot;100&quot;)
         + &quot;&amp;total_rooms_cost=&quot; + (vars.get(&quot;total_rooms_cost&quot;) ?: &quot;200&quot;)
         + &quot;&amp;final_price_reg=&quot;  + (vars.get(&quot;final_price_reg&quot;) ?: &quot;200&quot;)
         + &quot;&amp;final_price_hid=&quot;  + (vars.get(&quot;final_price_hid&quot;) ?: &quot;200&quot;)
         + &quot;&amp;GST_price=&quot;        + (vars.get(&quot;GST_price&quot;) ?: &quot;0&quot;)
         + &quot;&amp;firstname=Perf&quot;
         + &quot;&amp;lastname=Test&quot;
         + &quot;&amp;address=123+Test+Street&quot;
         + &quot;&amp;cc_type=Visa&quot;
         + &quot;&amp;cc_num=4111111111111111&quot;
         + &quot;&amp;cc_cvv=123&quot;
         + &quot;&amp;cc_exp_month=12&quot;
         + &quot;&amp;cc_exp_year=2028&quot;
         + &quot;&amp;Submit=Book+Now&quot;

vars.put(&quot;bookingFormBody&quot;, body)
log.info(&quot;S14 Booking | Hotel: &quot; + hotelName + &quot; | Thread: &quot; + ctx.getThread().getThreadName())
              </stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert - Booking submitted (confirmation page loaded)" enabled="true">
