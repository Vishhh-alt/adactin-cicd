          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="05 - GET Booking Confirmation (S14: read-after-write | S15: extract bookingRef)" enabled="true">
            <stringProp name="HTTPSampler.path">/BookedItinerary.php</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="S15 Assert - Booking Reference present (HTTP 200 hides failed bookings)" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="1045631711">Booking Confirmation id</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message">Booking reference not found on confirmation page. Booking may have failed silently (returned HTTP 200 with error).</stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">2</intProp>
            </ResponseAssertion>
            <hashTree/>
            <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="SLA: Confirmation page must load within 3000ms" enabled="true">
              <stringProp name="DurationAssertion.duration">3000</stringProp>
            </DurationAssertion>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="S14+15 PostProcessor - Extract bookingRef + log result" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">
// Null safety guards — always first in PostProcessor
def body = prev.getResponseDataAsString()
if (!body) { vars.put(&quot;bookingRef&quot;, &quot;EMPTY&quot;); return }
if (!prev.isSuccessful()) {
    log.warn(&quot;S14 Confirmation failed | HTTP: &quot; + prev.getResponseCode() + &quot; | Thread: &quot; + ctx.getThread().getThreadName())
    vars.put(&quot;bookingRef&quot;, &quot;FAILED&quot;)
    return
}

// Extract booking reference - primary pattern
def ref = null
def m = body =~ /Booking Confirmation id[^:]*:\s*&lt;\/b&gt;\s*([A-Z0-9]+)/
if (m.find()) { ref = m.group(1)?.trim() }

// Fallback pattern if HTML changed
if (!ref) {
    def m2 = body =~ /([A-Z]{2}[0-9]{5,8})/
    if (m2.find()) { ref = m2.group(1)?.trim() }
}

vars.put(&quot;bookingRef&quot;, ref ?: &quot;REF_NOT_FOUND&quot;)
if (ref) {
    log.info(&quot;S14 Booking confirmed | Ref: &quot; + ref + &quot; | Thread: &quot; + ctx.getThread().getThreadName())
} else {
    log.warn(&quot;S14 Ref not found | Check regex vs actual page HTML in View Results Tree&quot;)
}
              </stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
